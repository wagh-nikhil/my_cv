```{r career-skill-timeline, echo=FALSE, results='asis', echo=FALSE, warning=FALSE, message=FALSE, fig.width=10, fig.height=6}
library(plotly)
library(dplyr)
library(lubridate)

# ---- Data ----
timeline <- tribble(
  ~Name, ~Type, ~Start, ~End,
  "Novartis (Principal Clinical Programmer)", "Company", "2022-09", "Present",
  "Labcorp (Programming Lead)", "Company", "2021-09", "2022-09",
  "Syneos Health (Statistical Programmer)", "Company", "2017-06", "2021-09",
  "TCS (Clinical SAS Programmer)", "Company", "2013-10", "2017-06",
  "Cytel (Officer - Training)", "Company", "2013-03", "2013-10",
  "SAS", "Skill", "2013-03", "Present",
  "SQL", "Skill", "2014-01", "Present",
  "Spotfire", "Skill", "2013-10", "2017-06",
  "R", "Skill", "2022-01", "Present",
  "Python", "Skill", "2022-09", "Present",
  "Data Science (ML/AI)", "Skill", "2022-09", "Present",
  "Shiny", "Skill", "2022-09", "Present",
  "Jreview", "Skill", "2022-09", "Present",
  "Git/Gitlab/ClearCase", "Skill", "2022-09", "Present"
)

# ---- Prepare data ----
timeline <- timeline %>%
  mutate(
    Start_Date = if_else(Start == "Present", format(Sys.Date(), "%Y-%m"), Start),
    End_Date   = if_else(End == "Present", format(Sys.Date(), "%Y-%m"), End),
    Start1     = ymd(paste0(Start_Date, "-01")),
    End1       = ymd(paste0(End_Date, "-01")) + days(1)
  )

career_start <- min(timeline$Start1)

timeline <- timeline %>%
  mutate(
    Start_exp = as.numeric(difftime(Start1, career_start, units = "days")) / 365.25,
    End_exp   = as.numeric(difftime(End1, career_start, units = "days")) / 365.25
  )

company_df <- timeline %>% filter(Type == "Company") %>% arrange(Start1)
skill_df   <- timeline %>% filter(Type == "Skill") %>% arrange(Start1)

# Assign numeric y positions for skills
skill_df <- skill_df %>%
  mutate(y_pos = row_number())

# Y-axis labels (skill names)
y_labels <- setNames(skill_df$y_pos, skill_df$Name)

# ---- Company colors ----
company_colors <- c(
  "Cytel (Officer - Training)" = "#FFBE0B",
  "TCS (Clinical SAS Programmer)" = "#FB5607",
  "Syneos Health (Statistical Programmer)" = "#FF006E",
  "Labcorp (Programming Lead)" = "#8338EC",
  "Novartis (Principal Clinical Programmer)" = "#3A86FF"
)

# ---- Build Plotly Graph ----
p <- plot_ly()

# Add company background rectangles
for (i in seq_len(nrow(company_df))) {
  p <- add_trace(
    p,
    type = "scatter",
    mode = "none",
    fill = "toself",
    name = company_df$Name[i],   # 👈 add this line
    fillcolor = adjustcolor(company_colors[company_df$Name[i]], alpha.f = 0.25),
    hoverinfo = "text",
    text = paste0(
      "<b>Company:</b> ", company_df$Name[i], "<br>",
      "<b>From:</b> ", company_df$Start[i], "<br>",
      "<b>To:</b> ", company_df$End[i]
    ),
    x = c(company_df$Start_exp[i], company_df$End_exp[i],
          company_df$End_exp[i], company_df$Start_exp[i]),
    y = c(0.5, 0.5, max(skill_df$y_pos) + 0.5, max(skill_df$y_pos) + 0.5),
    showlegend = FALSE
  )
}
# Add skill bars
p <- add_trace(
  p,
  type = "bar",
  orientation = "h",
  y = skill_df$y_pos,
  x = skill_df$End_exp - skill_df$Start_exp,
  base = skill_df$Start_exp,
  marker = list(color = "#00A8E8"),
  hoverinfo = "text",
  text = paste0(
    "<b>Skill:</b> ", skill_df$Name, "<br>",
    "<b>From:</b> ", format(skill_df$Start1, "%b %Y"), "<br>",
    "<b>To:</b> ", ifelse(skill_df$End == "Present", "Present", format(skill_df$End1, "%b %Y"))
  ),
  name = "Skills"
)

# Add layout
p <- layout(
  p,
  title = list(
    text = "Career & Skill Timeline — Nikhil Wagh",
    x = 0.05,
    font = list(size = 18, family = "Arial", color = "#222")
  ),
  xaxis = list(
    title = "Years of Experience",
    tickvals = seq(0, ceiling(max(skill_df$End_exp)), 1),
    ticktext = paste0(seq(0, ceiling(max(skill_df$End_exp)), 1), "y"),
    gridcolor = "#EAEAEA"
  ),
  yaxis = list(
    title = "",
    tickvals = skill_df$y_pos,
    ticktext = skill_df$Name,
    gridcolor = "transparent"
  ),
  bargap = 0.25,
